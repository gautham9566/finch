ARG BASE_IMAGE=finch-base:latest
FROM ${BASE_IMAGE}

USER finchuser
COPY --chown=finchuser:finchuser pipelines ./pipelines
COPY --chown=finchuser:finchuser web/backend ./web/backend
COPY --chown=finchuser:finchuser web/__init__.py ./web/__init__.py

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
CMD ["uvicorn", "web.backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
